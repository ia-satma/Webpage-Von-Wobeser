{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "start:workspace": "node scripts/start-workspace.mjs",
    "prebuild": "npm run build:public-css",
    "build": "node --import tsx script/build.ts",
    "build:public-css": "node scripts/build-public-css.mjs",
    "start": "NODE_ENV=production node dist/index.cjs",
    "verify:video-runtime": "node scripts/verify-video-runtime.mjs",
    "start:deploy": "node scripts/start-deploy.mjs",
    "check": "tsc",
    "test:agents": "node --import tsx --test server/security/agent*.test.ts",
    "pretest:security": "node scripts/clean-appledouble.mjs",
    "test:security": "node --import tsx --test server/security/*.test.ts",
    "test:performance": "node scripts/check-performance-budgets.mjs",
    "audit:high": "node --import tsx scripts/audit-high-severity.ts",
    "audit:publications": "node scripts/audit-publications.mjs",
    "agents:cleanup-diagnostic-audit": "node --import tsx scripts/cleanup-diagnostic-audit-jobs.ts",
    "audits:cleanup-open": "node --import tsx scripts/cleanup-open-audit-findings.ts",
    "audit:typography-content": "node scripts/audit-content-typography.mjs",
    "media:optimize": "node scripts/generate-performance-assets.mjs && node scripts/generate-attorney-image-variants.mjs",
    "media:migrate-storage": "node --import tsx scripts/migrate-media-to-app-storage.ts",
    "media:migrate-private": "node --import tsx scripts/migrate-private-cvs-to-app-storage.ts",
    "presentations:inventory": "node scripts/presentation-storage-safety.mjs --mode=inventory",
    "presentations:quarantine": "node scripts/presentation-storage-safety.mjs --mode=quarantine",
    "handoff:storage": "node scripts/handoff-app-storage.mjs",
    "handoff:private": "node scripts/handoff-private-documents.mjs",
    "handoff:status": "node scripts/client-handoff.mjs status",
    "handoff:install": "node scripts/client-handoff.mjs install",
    "handoff:readiness": "node scripts/verify-client-handoff.mjs",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:replit-migrate": "node scripts/migrate-database-to-replit.mjs",
    "security:retire-legacy-users": "node scripts/retire-legacy-users.mjs",
    "admin:recover": "node --import tsx scripts/recover-admin.ts"
  },
