    "@types/dompurify": "^3.0.5",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "24.13.3",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/sanitize-html": "^2.16.1",
