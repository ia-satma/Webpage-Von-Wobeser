modules = ["nodejs-24", "web"]
run = "npm run start:workspace"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["unzip", "jq", "clamav", "ffmpeg", "postgresql_16"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start:deploy"]

[[ports]]
localPort = 5000
externalPort = 80

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run start:workspace"
waitForPort = 5000

[agent]
integrations = ["javascript_openai:1.0.0", "javascript_openai_ai_integrations:1.0.0", "javascript_gemini_ai_integrations:1.0.0"]
expertMode = true

# En un Repl importado, `npm run handoff:status -- --directory=.handoff`
# detecta si faltan recursos, secretos o restauración. Hasta terminar
# `npm run handoff:install`, el Repl sirve solamente una pantalla segura de
# instalación, no el sitio del cliente.
# ADMIN_EMAIL y ADMIN_BOOTSTRAP_PASSWORD se configuran exclusivamente en
# Replit → Tools → Secrets. ADMIN_BOOTSTRAP_PASSWORD solo crea
# al Dueño si ADMIN_EMAIL todavía no existe; una recuperación de una cuenta existente
# requiere ejecutar manualmente `npm run admin:recover -- --confirm=<correo>`.
# Para proteger a Dueño y Administradores con TOTP, definir en Secrets
# MFA_ENCRYPTION_KEY (32 bytes aleatorios codificados en base64 o hex) y
# MFA_REQUIRED_FOR_PRIVILEGED=true. No activar la segunda variable sin la clave:
# el servicio rechaza el acceso privilegiado en vez de degradarlo a contraseña sola.
# AI_MONTHLY_BUDGET_USD es opcional y limita el gasto mensual estimado (USD 100
# si se omite). Las claves de proveedores también deben permanecer en Secrets.
# Las imágenes y videos administrados requieren un bucket predeterminado vinculado
# desde Tools → App Storage. REPLIT_APP_STORAGE_BUCKET_ID solo es necesario si se
# desea seleccionar explícitamente un bucket distinto del predeterminado.
# MIGRATION_READ_ONLY=true bloquea temporalmente todas las escrituras HTTP y los
# procesos de fondo durante un corte de base de datos. SOURCE_DATABASE_URL y
# DB_BACKUP_ENCRYPTION_KEY son Secrets temporales; nunca deben quedar en Git.
# El ID del bucket tampoco se versiona: cada importación desde GitHub debe vincular
# su propio App Storage y, si hace falta, definir REPLIT_APP_STORAGE_BUCKET_ID.

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 90000

[userenv]

[userenv.shared]
AI_INTEGRATIONS_OPENAI_BASE_URL = "https://api.openai.com/v1"
